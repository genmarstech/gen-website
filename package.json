{
  "name": "gen-website",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing website for Genmars Tech Limited — genmars.co.ke",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run clean && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "verify": "npm run check:theme && npm run typecheck && npm run build",
    "clean": "node -e \"const{rmSync}=require('fs');for(const d of['.next','out'])try{rmSync(d,{recursive:true,force:true,maxRetries:5,retryDelay:200})}catch(e){console.error(d,e.code)}\"",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^10.9.1",
    "eslint-config-next": "^15.5.4",
    "typescript": "^7.0.2"
  }
}
