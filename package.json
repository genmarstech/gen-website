{
  "name": "gen-website",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing website for Genmars Tech Limited — genmars.co.ke",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run clean && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "verify": "npm run check:theme && npm run lint && npm run typecheck && npm run build",
    "clean": "node -e \"const{rmSync}=require('fs');for(const d of['.next','out'])try{rmSync(d,{recursive:true,force:true,maxRetries:5,retryDelay:200})}catch(e){console.error(d,e.code)}\"",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "typescript": "^6.0.3"
  }
}
