# ─────────────────────────────────────────────────────────────────────────────
# Caddy — inside the container.
#
# Serves the static export on :3000 over plain HTTP. It does NOT terminate TLS:
# that happens at the host Caddy (see host.Caddyfile), and the container port is
# published only to 127.0.0.1, so this listener is never reachable off-box.
# ─────────────────────────────────────────────────────────────────────────────

{
	# No certificates are issued here — the edge does that.
	auto_https off

	# The admin API is not used: this container is redeployed, never reloaded in
	# place. Turning it off removes a listener and a write path.
	admin off
	persist_config off

	log {
		output stdout
		format console
		level INFO
	}
}

:3000 {
	root * /srv

	# zstd first, gzip for anything that cannot take it.
	encode zstd gzip

	# ---- headers ------------------------------------------------------------
	# These run before routing, so they apply to every response including 404s.

	header {
		# Do not advertise the server.
		-Server

		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

		# The page loads nothing from anywhere else: fonts are self-hosted by
		# next/font, and there are no third-party scripts, analytics or CDNs.
		#
		# 'unsafe-inline' on script-src is required and unavoidable here. A static
		# export cannot mint per-request nonces, and the page carries two inline
		# scripts by design — the no-flash theme script (which must run before
		# first paint) and the JSON-LD block — plus Next's hydration payload.
		# With no user-generated content and no external input reaching the DOM,
		# the residual XSS surface is the build pipeline rather than the page.
		#
		# Making this strict requires server rendering so nonces can be issued.
		# That is an architecture change, not a header tweak — docs/DEPLOYMENT.md.
		#
		# Sign in and Request work send the browser to app.genmars.co.ke. Nothing
		# here needs widening for that: `form-action 'self'` governs form
		# submissions, and these are ordinary top-level navigations — a link, or
		# location.assign(). CSP has no shipped directive that restricts those.
		# If a future change makes the site POST to the portal, or fetch from
		# api.genmars.co.ke, THAT needs form-action or connect-src opened — and
		# it should be questioned first, because it would put client data on the
		# public origin (docs/PORTAL-INTEGRATION.md §1).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# Fingerprinted assets: safe to cache forever.
	#
	# /media/* belongs here for the same reason /_next/static/* does, and only
	# for that reason: every file under it carries a content hash in its name
	# (scripts/build-media.mjs), so changing a photograph changes its filename
	# and no cache anywhere can hand back the old one. Never add an unhashed
	# path to this matcher — a year is a very long time to serve a stale image
	# with no way to purge it.
	@immutable path /_next/static/* /media/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Documents: always revalidate, so a deploy is visible immediately rather
	# than whenever a stale copy happens to expire.
	#
	# One `path` line with several patterns — a named matcher block may not
	# repeat the same matcher type, and multiple patterns on one line are OR'd.
	@documents path *.html / */
	header @documents Cache-Control "public, max-age=0, must-revalidate"

	# security.txt (RFC 9116) carries an expiry date and must be re-issued
	# before it passes. Revalidating rather than caching means the renewed file
	# is live the moment it ships, instead of whenever a stale copy happens to
	# expire — which for a document about how to reach us in a hurry is the
	# whole point.
	@securitytxt path /.well-known/security.txt
	header @securitytxt {
		Cache-Control "public, max-age=0, must-revalidate"
		Content-Type "text/plain; charset=utf-8"
	}

	# ---- routing ------------------------------------------------------------
	# `handle` blocks are mutually exclusive and evaluated in the order written,
	# which is why they are used here rather than bare directives.
	#
	# This matters for /healthz specifically: Caddy sorts bare directives into
	# its own fixed order, in which `try_files` runs BEFORE `respond`. A bare
	# `respond /healthz` would therefore never fire — try_files would first
	# rewrite the path to /healthz.html (its last argument, used when nothing
	# matches), and the /healthz matcher would no longer match. The healthcheck
	# would 404 and the container would be marked unhealthy forever.

	handle /healthz {
		respond "ok" 200
	}

	# ── RETIRED PATHS ────────────────────────────────────────────────────────
	# /request/ was the old "request work" page: a free-text form that composed
	# an email. Ordering now happens per tier on /services/, which answers the
	# same question and more, so the path is a permanent redirect rather than a
	# 404.
	#
	# 301 and not 308 deliberately. This is a GET-only marketing page with no
	# form left to re-submit, and 301 is the status search engines treat as
	# "move the ranking" rather than merely "look over there". Both spellings
	# are matched because the old page was linked with and without the slash.
	#
	# Placed BEFORE the trailing-slash rule: that matcher requires
	# file {path}/index.html to exist, and this page no longer exists, so
	# /request would otherwise fall through to a 404 rather than redirect.
	@retired path /request /request/
	redir @retired /services/ 301

	# ── ONE URL PER PAGE ─────────────────────────────────────────────────────
	# next.config.ts sets trailingSlash: true and every canonical and sitemap
	# entry uses the slash. Without this redirect /services AND /services/ both
	# returned 200 with byte-identical content — two URLs for one page.
	#
	# The canonical tag alone would have been enough for Google to consolidate
	# them, but a 308 is the stronger signal, it stops the duplicate being
	# linked or shared in the first place, and it costs one matcher.
	#
	# Excludes, in order of how easy each is to break:
	#   · anything with a dot — /robots.txt, /sitemap.xml, /og.png, every asset
	#   · /healthz — no extension and no trailing slash, so it WOULD be caught,
	#     and redirecting the health probe would take the container out of
	#     rotation the moment this shipped
	#   · / itself, which already ends in a slash
	# `file` is the condition that makes this safe, and the smoke test is what
	# proved it necessary: without it the matcher caught EVERY extensionless
	# path, so /does-not-exist 308'd to /does-not-exist/ and only then 404'd.
	# A redirect chain to a 404 is worse than a 404 — it wastes a crawl and
	# reports the wrong status to anything following the first hop.
	@needsTrailingSlash {
		not path */
		not path /*.*
		not path /healthz
		file {path}/index.html
	}
	redir @needsTrailingSlash {path}/ 308

	handle {
		# The export is a tree of directories containing index.html. This
		# resolves /approach/ and /approach/index.html to the same file.
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	# The exported 404 page, served with a real 404 status.
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
